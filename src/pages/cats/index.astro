---
import SiteLayout from '@/layouts/SiteLayout.astro';
import CatCollage from '@/components/CatCollage';
import { getCatImages } from '@/lib/cloudinary';
import '@/styles/cats.css';

const photos = await getCatImages();
---

<SiteLayout
    title='Cats | Marta Makes Things'
    description='Drusy and Lino, the photogenic voids who run this place — a growing collage of cat photos.'
    headerText='MartaHasCats'
>
    <div class='border-b border-slate-200 pb-4 mb-6 dark:border-slate-700'>
        <h1>Drusy &amp; Lino, the photogenic voids</h1>
        <p class='mt-1 text-slate-500 dark:text-slate-400'>
            A little collage, growing one nap at a time
        </p>
    </div>

    <CatCollage photos={photos} client:load />
</SiteLayout>
