---
import SiteLayout from '@/layouts/SiteLayout.astro';
import CatCollage from '@/components/CatCollage';
import { getCatImages } from '@/lib/cloudinary';
import { arrangeCollageRows } from '@/lib/collage';
import '@/styles/cats.css';

// Arranged here rather than in the component so the layout is worked out
// once per build — i.e. whenever new photos are uploaded and the site
// redeploys — instead of on every page load.
const rows = arrangeCollageRows(await getCatImages());
---

<SiteLayout
    title='Cats | Marta Makes Things'
    description='Photos of Drusy and Lino, the cats who run this place — naps, stares and the occasional zoomie.'
    headerText='MartaHasCats'
>
    <div class='border-b border-slate-200 pb-4 mb-6 dark:border-slate-700'>
        <h1>Drusy &amp; Lino, the photogenic voids</h1>
        <p class='mt-1 text-slate-500 dark:text-slate-400'>
            Naps, stares and the occasional zoomie
        </p>
    </div>

    <CatCollage rows={rows} client:load />
</SiteLayout>
